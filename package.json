{
  "name": "shortround",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm build && pnpm --parallel --filter \"./packages/*\" --filter @shortround/sample-todo-app run dev",
    "storybook": "pnpm build && pnpm --filter @shortround/storybook dev:storybook",
    "test": "pnpm -r run test",
    "test:release": "vitest run --config release-tools/vitest.config.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx}\"",
    "verify": "pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm --filter @shortround/core test:node-import && pnpm --filter @shortround/react test:node-import && pnpm test:release && node release-tools/check-migration-guide.js && pnpm --filter @shortround/react types:check && pnpm lint && pnpm format:check && pnpm --filter @shortround/storybook build:storybook",
    "dev:watch": "pnpm --parallel --filter \"./packages/*\" run dev"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "9.0.15",
    "globals": "^16.2.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1"
}
