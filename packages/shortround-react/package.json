{
  "name": "@shortround/react",
  "version": "0.5.0",
  "description": "ShortRound for React: the command palette, the sidekick, the provider and the theme contract, on @shortround/core.",
  "keywords": [
    "shortround",
    "command palette",
    "intentional ui",
    "react",
    "hooks"
  ],
  "author": "Chris Sepulveda <csepulv@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csepulv/shortround.git",
    "directory": "packages/shortround-react"
  },
  "bugs": {
    "url": "https://github.com/csepulv/shortround/issues"
  },
  "homepage": "https://github.com/csepulv/shortround#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/react.es.js",
  "module": "./dist/react.es.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/react.es.js",
      "default": "./dist/react.es.js"
    }
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "CHANGELOG.md"
  ],
  "types": "./src/index.d.ts",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "types:check": "tsc -p types-check",
    "test:node-import": "node scripts/check-node-import.js"
  },
  "devDependencies": {
    "@shortround/core": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.1.8",
    "@vitejs/plugin-react": "^4.6.0",
    "jest-extended": "^6.0.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "vite": "^7.3.6",
    "typescript": "5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@shortround/core": "^0.5.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "framer-motion": "^12.19.1",
    "tiny-invariant": "^1.3.3"
  }
}
