{
  "name": "@shortround/core",
  "version": "0.6.0",
  "description": "ShortRound's headless core: the command palette's state, matching, catalog engine, command builder and constants, with no UI. @shortround/react draws it.",
  "keywords": [
    "shortround",
    "command palette",
    "intentional ui",
    "headless"
  ],
  "author": "Chris Sepulveda <csepulv@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csepulv/shortround.git",
    "directory": "packages/shortround-core"
  },
  "bugs": {
    "url": "https://github.com/csepulv/shortround/issues"
  },
  "homepage": "https://github.com/csepulv/shortround#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/core.es.js",
  "module": "./dist/core.es.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/core.es.js",
      "default": "./dist/core.es.js"
    }
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "src/catalog/index.d.ts",
    "CATALOG.md",
    "ADOPTING-A-CATALOG.md",
    "CHANGELOG.md",
    "CHANGELOG-catalog.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:node-import": "node scripts/check-node-import.js"
  },
  "devDependencies": {
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "damerau-levenshtein": "^1.0.8",
    "fuzzysort": "^3.1.0",
    "jsep": "^1.6.0",
    "tiny-invariant": "^1.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.16"
  },
  "types": "./src/index.d.ts"
}
